\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Gaussian beam parameters. At the waist ($z=0$) the beam radius is $w_0$ and the wavefront is a plane wave. At $z=z_R$ (the Rayleigh length) the radius has grown to $\sqrt  2\,w_0$. Farther away the wavefronts become curved with radius $R(z)$, and the beam envelope (red) approaches the asymptotes of half-angle $\theta $, the far-field divergence. Source of the figure: course \emph  {Optique et Photonique Instrumentale}, Le Mans Universit\'e (F.~Varet), \url  {https://perso.univ-lemans.fr/~fvaret/opi/cours_maj/OPI_ang_M01_C03_web_gen_auroraW/co/Contenu_08.html}.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:gaussparams}{{6}{9}{Gaussian beam parameters. At the waist ($z=0$) the beam radius is $w_0$ and the wavefront is a plane wave. At $z=z_R$ (the Rayleigh length) the radius has grown to $\sqrt 2\,w_0$. Farther away the wavefronts become curved with radius $R(z)$, and the beam envelope (red) approaches the asymptotes of half-angle $\theta $, the far-field divergence. Source of the figure: course \emph {Optique et Photonique Instrumentale}, Le Mans Universit\'e (F.~Varet), \url {https://perso.univ-lemans.fr/~fvaret/opi/cours_maj/OPI_ang_M01_C03_web_gen_auroraW/co/Contenu_08.html}}{figure.caption.13}{}}
